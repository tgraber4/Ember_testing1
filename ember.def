Bootstrap: docker
From: python:3.10-slim

%post
    apt-get update
    apt-get install -y --no-install-recommends libgomp1
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir \
        "lightgbm>=4.6.0" \
        "pefile>=2024.8.26" \
        "polars>=1.8.2" \
        "scikit-learn>=1.5.1" \
        "tqdm>=4.66.5" \
        "signify>=0.9.1,<0.10" \
        "shap>=0.46.0" \
        "huggingface_hub>=0.32.4" \
        "matplotlib>=3.10.3"

%environment
    # Ignore packages in the host's ~/.local so only the image's packages are used.
    export PYTHONNOUSERSITE=1

%test
    python -c "import lightgbm, pefile, polars, sklearn, tqdm, signify, huggingface_hub, matplotlib, shap; print('ok')"

%help
    Python 3.10 with the thrember (EMBER2024) dependencies and libgomp1 for LightGBM.
    thrember itself is not installed; point PYTHONPATH at EMBER2024/src.
